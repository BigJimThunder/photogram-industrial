<%= form_with(model: @photo, local: true) do |form| %>
  <div class="mb-3">
    <%= form.label :caption %>
    <%= form.text_field :caption, class: "form-control" %>
  </div>

  <div class="mb-3">
    <%= form.label :image %>
    <%= form.file_field :image, class: "form-control" %>
  </div>

  <%= form.submit "Update Photo", class: "btn btn-primary" %>
<% end %>
