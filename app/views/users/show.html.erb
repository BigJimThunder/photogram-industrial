<div class="row">
  <div class="col-md-6 offset-3">
    <h1>
      <%= @user.username %>
    </h1>

    <ul class="nav nav-pills nav-justified">
      <li class="nav-item">
        <%= link_to "Posts", user_path(@user.username), class: "nav-link" %>
      </li>
      <li class="nav-item">
        <%= link_to "Liked photos", liked_path(@user.username), class: "nav-link" %>
      </li>
    </ul>
  </div>
</div>
<div class="d-flex justify-content-center gap-3 my-3">
  <%= link_to "followers", "#followersModal", class: "btn btn-outline-secondary", role: "button", data: { bs_toggle: "modal", bs_target: "#followersModal", turbo: false } %>

  <%= link_to "following", "#followingModal", class: "btn btn-outline-secondary", role: "button", data: { bs_toggle: "modal", bs_target: "#followingModal", turbo: false } %>

</div>
<%= render "users/connected_users_modal", 
            target: "followersModal", 
            user: @user, 
            description: "followers", 
            connected_users: @followers %>

<%= render "users/connected_users_modal", 
            target: "followingModal", 
            user: @user, 
            description: "following", 
            connected_users: @leaders %>


<% if current_user != @user %>
  <% if @outgoing_request.present? %>
    <% if @outgoing_request.pending? %>
      <%= button_to "Un-request", follow_request_path(@outgoing_request), method: :delete, class: "btn btn-warning mb-2" %>
    <% elsif @outgoing_request.accepted? %>
      <%= button_to "Un-follow", follow_request_path(@outgoing_request), method: :delete, class: "btn btn-danger mb-2" %>
    <% end %>
  <% else %>
    <%= form_with url: follow_requests_path, method: :post, local: true do |form| %>
      <%= form.hidden_field :recipient_id, value: @user.id %>
      <%= form.hidden_field :sender_id, value: current_user.id %>
      <%= form.submit "Request to Follow", class: "btn btn-primary mb-2" %>
    <% end %>
  <% end %>
<% end %>


<h2>Own Photos</h2>
<% if @user != current_user %>
  <% @incoming_requests.each do |request| %>
    <% if request.sender == @user %>
      <div class="d-flex justify-content-between align-items-center mb-3">
        <span><%= @user.username %> has requested to follow you</span>
        <div>
          <%= button_to "Accept #{@user.username}'s request", follow_request_path(request, status: "accepted"), method: :patch, class: "btn btn-success btn-sm" %>
          <%= button_to "Decline #{@user.username}'s request", follow_request_path(request, status: "rejected"), method: :patch, class: "btn btn-danger btn-sm" %>
        </div>
      </div>
    <% end %>
  <% end %>
<% end %>
<div class="row mb-4">
  <div class="col-md-6 offset-md-3">
    <%= render "users/user", user: @user %>
  </div>
</div>

<div class="row mb-2">
  <div class="col-md-6 offset-md-3">
    <%= render "users/profile_nav", user: @user %>
  </div>
</div>

<% @user.own_photos.each do |photo| %>
  <%= render "photos/photo", photo: photo %>
<% end %>
